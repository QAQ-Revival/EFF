#include <winver.h>
#include "eiem_version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION EIEM_VERSION_MAJOR,EIEM_VERSION_MINOR,EIEM_VERSION_PATCH,EIEM_VERSION_REVISION
PRODUCTVERSION EIEM_VERSION_MAJOR,EIEM_VERSION_MINOR,EIEM_VERSION_PATCH,EIEM_VERSION_REVISION
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS__WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "EFF - Endfield Mod Framework"
            VALUE "FileVersion", EIEM_FILE_VERSION
            VALUE "InternalName", "eff"
            VALUE "OriginalFilename", "eff.dll"
            VALUE "ProductName", "EFF"
#if EIEM_VERSION_REVISION
            VALUE "ProductVersion", EIEM_FILE_VERSION
#else
            VALUE "ProductVersion", EIEM_VERSION
#endif
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
